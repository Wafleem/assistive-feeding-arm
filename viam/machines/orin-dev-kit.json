    {
      "name": "arm-camera",
      "api": "rdk:component:camera",
      "model": "rdk:builtin:webcam",
      "attributes": {
        "height_px": 480,
        "width_px": 640,
        "format": "YUYV",
        "video_path": "usb-icSpring_icspring_camera-video-index0",
        "frame_rate": 30
      }
    },
    {
      "name": "webcam-2",
      "api": "rdk:component:camera",
      "model": "rdk:builtin:webcam",
      "attributes": {
        "height_px": 480,
        "width_px": 640,
        "video_path": "usb-046d_C270_HD_WEBCAM_7DEF8890-video-index0",
        "format": "MJPEG",
        "frame_rate": 30
      },
      "frame": {
        "parent": "follower-arm",
        "translation": {
          "x": -21,
          "y": -8,
          "z": 90
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": -90
          }
        }
      }
    },
    {
      "name": "detections-view",
      "api": "rdk:component:camera",
      "model": "rdk:builtin:transform",
      "attributes": {
        "pipeline": [
          {
            "attributes": {
              "detector_name": "spoon-detector",
              "confidence_threshold": 0.3,
              "valid_labels": [
                "bowl",
                "cup",
                "spoon",
                "person",
                "dining table",
                "fork",
                "knife",
                "apple",
                "banana",
                "orange",
                "carrot",
                "broccoli",
                "sandwich",
                "donut",
                "cake"
              ]
            },
            "type": "detections"
          }
        ],
        "source": "webcam-2"
      }
    },
    {
      "name": "spoon",
      "api": "rdk:component:generic",
      "model": "viam:obstacle-pack:obstacle",
      "attributes": {
        "geometries": [
          {
            "y": 45,
            "label": "spoon",
            "x": 50,
            "z": 143,
            "type": "box"
          }
        ]
      },
      "frame": {
        "parent": "follower-gripper",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 61.5
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": 0
          }
        }
      }
    },
    {
      "name": "webcam-2-depth",
      "api": "rdk:component:camera",
      "model": "assistive-arm:depth-anything-3:camera",
      "attributes": {
        "weights": "/home/ultraviolet/depth-anything-3/weights/DA3METRIC-LARGE",
        "produce_hz": 5,
        "hfov_deg": 45,
        "source": "webcam-2",
        "preview_port": 8766
      },
      "frame": {
        "parent": "follower-arm",
        "translation": {
          "x": -21,
          "y": -8,
          "z": 90
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": -90
          }
        }
      }
    },
    {
      "name": "webcam-2-range",
      "api": "rdk:component:sensor",
      "model": "assistive-arm:depth-anything-3:range",
      "attributes": {
        "camera": "webcam-2-depth"
      }
    }
  ],
  "services": [
    {
      "name": "discovery-arm",
      "api": "rdk:service:discovery",
      "model": "devrel:so101:discovery",
      "attributes": {}
    },
    {
      "name": "teleop",
      "api": "rdk:service:generic",
      "model": "devrel:so101:teleop",
      "attributes": {
        "manage_leader_torque": true,
        "follower_gripper": "follower-gripper",
        "follower_arm": "follower-arm",
        "leader_arm": "leader-arm",
        "rate_hz": 100,
        "leader_gripper": "leader-gripper",
        "auto_start": true
      },
      "disabled": false
    },
    {
      "name": "spoon-detector",
      "api": "rdk:service:vision",
      "model": "viam-labs:vision:yolov8",
      "attributes": {
        "task": "detect",
        "camera_name": "webcam-2",
        "model_location": "yolov8s.pt",
        "confidence": 0.3
      }
    }
  ],
  "modules": [
    {
      "type": "registry",
      "name": "devrel_so101-arm",
      "module_id": "devrel:so101-arm",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "viam_obstacle-pack",
      "module_id": "viam:obstacle-pack",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "viam-labs_YOLOv8",
      "module_id": "viam-labs:YOLOv8",
      "version": "latest"
    },
    {
      "type": "local",
      "name": "depth-anything-3",
      "executable_path": "/home/ultraviolet/depth-anything-3/run.sh",
      "env": {
        "DA3_PREVIEW": "stream",
        "PYTHONUNBUFFERED": "1",
        "DA3_LOG_LEVEL": "WARN"
      }
    }
  ]
}
