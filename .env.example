# Copy to .env (git-ignored) and fill in only what you use. Never commit real keys.

# Language layer: fallback order of LLM backends. The rule parser is always last.
# Default is local only: nothing said leaves our hardware.
ASSIST_LLM_BACKENDS=local
# ASSIST_LLM_BACKENDS=local,anthropic,openai

# Local model on the AGX Orin (Ollama / llama.cpp, OpenAI-compatible endpoint)
ASSIST_LOCAL_LLM_URL=http://localhost:11434/v1
ASSIST_LOCAL_LLM_MODEL=

# Cloud backends: API keys, NOT ChatGPT/Claude subscriptions (ask the organisers for credits)
ANTHROPIC_API_KEY=
ASSIST_ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
ASSIST_OPENAI_MODEL=

# Viam (real robot)
VIAM_ADDRESS=
VIAM_API_KEY=
VIAM_API_KEY_ID=
