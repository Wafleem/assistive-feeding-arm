{
  "_note": "Snapshot of the orin-dev-kit (Jetson AGX Orin, Ubuntu 24.04, JetPack 7, viam-server 1.13) machine config, 2026-10-23. SO-101 leader + follower with teleop (auto_start ON since 2026-10-23: the venue Wi-Fi kept live commands from reaching the Orin; set it back to false when the network is reliable). Calibration sensors disabled. Cameras: webcam-2 = Logitech C270 taped on top of the gripper, centred, lens forward along the spoon (frame on follower-arm, estimated from photos); arm-camera = icSpring wrist module that enumerates but sends no frames (hardware fault). spoon-detector = YOLOv8s COCO on webcam-2 (bowl, cup, spoon, person, ...); detections-view = transform camera that overlays its boxes for viewing in the Viam app. spoon = collision box for the spoon taped in the fixed jaw (on follower-gripper, whose frame is the jaw-tip TCP), so the motion planner keeps it off the table. No secrets are stored here.",
  "components": [
    {
      "name": "follower-arm",
      "api": "rdk:component:arm",
      "model": "devrel:so101:arm",
      "attributes": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C124377-if00",
        "calibration_file": "so101_follower_calibration.json"
      },
      "frame": {
        "parent": "world",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": 0
          }
        }
      }
    },
    {
      "name": "follower-gripper",
      "api": "rdk:component:gripper",
      "model": "devrel:so101:gripper",
      "attributes": {
        "arm": "follower-arm"
      },
      "frame": {
        "parent": "follower-arm",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": 0
          }
        }
      }
    },
    {
      "name": "follower-calibration",
      "api": "rdk:component:sensor",
      "model": "devrel:so101:calibration",
      "ui_folder": {
        "name": "calibration"
      },
      "attributes": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C124377-if00",
        "calibration_file": "so101_follower_calibration.json"
      },
      "disabled": true
    },
    {
      "name": "table",
      "api": "rdk:component:generic",
      "model": "viam:obstacle-pack:obstacle",
      "attributes": {
        "geometries": [
          {
            "label": "table",
            "type": "box",
            "x": 1447.8,
            "y": 685.8,
            "z": 30
          }
        ]
      },
      "frame": {
        "parent": "world",
        "translation": {
          "x": 698.1,
          "y": 266.7,
          "z": -15
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": 0
          }
        }
      }
    },
    {
      "name": "spoon",
      "api": "rdk:component:generic",
      "model": "viam:obstacle-pack:obstacle",
      "attributes": {
        "geometries": [
          {
            "label": "spoon",
            "type": "box",
            "x": 50,
            "y": 45,
            "z": 143
          }
        ]
      },
      "frame": {
        "parent": "follower-gripper",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 61.5
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": 0
          }
        }
      }
    },
    {
      "name": "leader-arm",
      "api": "rdk:component:arm",
      "model": "devrel:so101:arm",
      "attributes": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C124416-if00",
        "calibration_file": "so101_leader_calibration.json"
      },
      "frame": {
        "parent": "world",
        "translation": {
          "x": 0,
          "y": -600,
          "z": 0
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": 0
          }
        }
      }
    },
    {
      "name": "leader-gripper",
      "api": "rdk:component:gripper",
      "model": "devrel:so101:gripper",
      "attributes": {
        "arm": "leader-arm"
      },
      "frame": {
        "parent": "leader-arm",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": 0
          }
        }
      }
    },
    {
      "name": "leader-calibration",
      "api": "rdk:component:sensor",
      "model": "devrel:so101:calibration",
      "ui_folder": {
        "name": "calibration"
      },
      "attributes": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C124416-if00",
        "calibration_file": "so101_leader_calibration.json"
      },
      "disabled": true
    },
    {
      "name": "arm-camera",
      "api": "rdk:component:camera",
      "model": "rdk:builtin:webcam",
      "attributes": {
        "video_path": "usb-icSpring_icspring_camera-video-index0",
        "width_px": 640,
        "height_px": 480,
        "frame_rate": 30,
        "format": "YUYV"
      }
    },
    {
      "name": "webcam-2",
      "api": "rdk:component:camera",
      "model": "rdk:builtin:webcam",
      "attributes": {
        "video_path": "usb-046d_C270_HD_WEBCAM_7DEF8890-video-index0",
        "format": "MJPEG",
        "width_px": 640,
        "height_px": 480,
        "frame_rate": 30
      },
      "frame": {
        "parent": "follower-arm",
        "translation": {
          "x": -21,
          "y": -8,
          "z": 90
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": 1,
            "th": -90
          }
        }
      }
    },
    {
      "name": "detections-view",
      "api": "rdk:component:camera",
      "model": "rdk:builtin:transform",
      "attributes": {
        "source": "webcam-2",
        "pipeline": [
          {
            "type": "detections",
            "attributes": {
              "detector_name": "spoon-detector",
              "confidence_threshold": 0.3,
              "valid_labels": [
                "bowl",
                "cup",
                "spoon",
                "person",
                "dining table",
                "fork",
                "knife",
                "apple",
                "banana",
                "orange",
                "carrot",
                "broccoli",
                "sandwich",
                "donut",
                "cake"
              ]
            }
          }
        ]
      }
    }
  ],
  "services": [
    {
      "name": "discovery-arm",
      "api": "rdk:service:discovery",
      "model": "devrel:so101:discovery",
      "attributes": {}
    },
    {
      "name": "teleop",
      "api": "rdk:service:generic",
      "model": "devrel:so101:teleop",
      "attributes": {
        "leader_arm": "leader-arm",
        "follower_arm": "follower-arm",
        "leader_gripper": "leader-gripper",
        "follower_gripper": "follower-gripper",
        "rate_hz": 100,
        "manage_leader_torque": true,
        "auto_start": true
      }
    },
    {
      "name": "spoon-detector",
      "api": "rdk:service:vision",
      "model": "viam-labs:vision:yolov8",
      "attributes": {
        "model_location": "yolov8s.pt",
        "camera_name": "webcam-2",
        "task": "detect",
        "confidence": 0.25
      }
    }
  ],
  "modules": [
    {
      "type": "registry",
      "name": "devrel_so101-arm",
      "module_id": "devrel:so101-arm",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "viam_obstacle-pack",
      "module_id": "viam:obstacle-pack",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "viam-labs_YOLOv8",
      "module_id": "viam-labs:YOLOv8",
      "version": "latest"
    }
  ]
}
