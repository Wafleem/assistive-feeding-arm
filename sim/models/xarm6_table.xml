<!--
  Placeholder xArm6 + parallel gripper, table-mounted (the venue provides the
  arm), for development before hardware. Kinematics follow the UFACTORY xArm6 dimensions (d1 = 267 mm,
  upper arm 289.5 mm with a 53.5 mm offset, 77.5 mm elbow offset, forearm
  342.5 mm, wrist 76 mm + 97 mm); geometry is capsules, masses are rough.
  Swap in real meshes from UFACTORY's xarm_ros2 (xarm_description) URDF when
  visuals or self-collision matter; see docs/SIMULATION.md.

  Frames: the arm base body "arm_base" IS the base frame used by the code, and
  it sits at the world origin on the table top (z = 0 is the table surface).
  The previous wheelchair-mounted version is at git tag v0-wheelchair-skills.
-->
<mujoco model="xarm6_table">
  <compiler angle="radian" autolimits="true"/>
  <!-- elliptic cones + impratio + noslip: without them held objects creep out of a pinch grasp -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10" noslip_iterations="4"/>
  <visual>
    <global offwidth="640" offheight="480"/>
  </visual>

  <!-- Collision bits: arm geoms are contype=2/conaffinity=1, so the arm never
       collides with itself but does collide with everything else (default 1/1).
       Scene parts only the arm may touch use contype=4/conaffinity=2. -->
  <default>
    <default class="arm">
      <joint damping="2" armature="0.1"/>
      <geom type="capsule" rgba="0.85 0.85 0.88 1" contype="2" conaffinity="1" condim="3"/>
      <position kp="1500" kv="80" forcerange="-60 60"/>
    </default>
    <default class="finger">
      <joint type="slide" damping="5" armature="0.01"/>
      <geom type="box" rgba="0.2 0.2 0.22 1" friction="1.5 0.05 0.001" condim="6" contype="2" conaffinity="1"/>
      <position kp="4000" kv="40" forcerange="-40 40"/>
    </default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

  <worldbody>
    <!-- Fixed RGB-D camera on a clamp-on post at the table corner, looking at
         the plate and the user's face (mount="base": fixed in the arm base frame). -->
    <geom name="cam_post" class="visual" type="cylinder" fromto="-0.12 0.12 0 -0.12 0.12 0.6" size="0.012" rgba="0.3 0.3 0.3 1"/>
    <camera name="scene" pos="-0.12 0.12 0.62" xyaxes="0.1713 -0.9852 0.0000 0.7201 0.1252 0.6825" fovy="58"/>

    <body name="arm_base" pos="0 0 0">
        <geom class="visual" type="cylinder" size="0.06 0.04" pos="0 0 0.04" rgba="0.85 0.85 0.88 1"/>
        <body name="link1" gravcomp="1" pos="0 0 0.267" childclass="arm">
          <inertial pos="0 0 -0.05" mass="2.4" diaginertia="0.006 0.006 0.005"/>
          <joint name="joint1" axis="0 0 1" range="-6.28 6.28"/>
          <geom fromto="0 0 -0.20 0 0 0" size="0.05"/>
          <body name="link2" gravcomp="1">
            <inertial pos="0.03 0 0.14" mass="2.0" diaginertia="0.02 0.02 0.003"/>
            <joint name="joint2" axis="0 1 0" range="-2.06 2.09"/>
            <geom fromto="0 0 0 0.0535 0 0.2845" size="0.045"/>
            <body name="link3" gravcomp="1" pos="0.0535 0 0.2845">
              <inertial pos="0.04 0 -0.02" mass="1.2" diaginertia="0.004 0.004 0.002"/>
              <joint name="joint3" axis="0 1 0" range="-3.93 0.19"/>
              <geom fromto="0 0 0 0.0775 0 0" size="0.04"/>
              <body name="link4" gravcomp="1" pos="0.0775 0 0">
                <inertial pos="0 0 -0.17" mass="1.3" diaginertia="0.012 0.012 0.002"/>
                <joint name="joint4" axis="0 0 -1" range="-6.28 6.28"/>
                <geom fromto="0 0 0 0 0 -0.3425" size="0.038"/>
                <body name="link5" gravcomp="1" pos="0 0 -0.3425">
                  <inertial pos="0.03 0 -0.02" mass="1.0" diaginertia="0.002 0.002 0.001"/>
                  <joint name="joint5" axis="0 1 0" range="-1.69 3.14"/>
                  <geom fromto="0 0 0 0.076 0 0" size="0.035"/>
                  <body name="link6" gravcomp="1" pos="0.076 0 -0.097">
                    <inertial pos="0 0 0.02" mass="0.3" diaginertia="0.0005 0.0005 0.0005"/>
                    <joint name="joint6" axis="0 0 -1" range="-6.28 6.28"/>
                    <geom fromto="0 0 0.097 0 0 0" size="0.035"/>
                    <!-- gripper: F/T sensing happens across this body boundary -->
                    <body name="gripper" pos="0 0 0" gravcomp="1">
                      <inertial pos="0 0 -0.06" mass="0.8" diaginertia="0.002 0.002 0.001"/>
                      <site name="ft_site" pos="0 0 0" size="0.01" rgba="1 0 0 1" group="4"/>
                      <geom name="palm" type="box" pos="0 0 -0.04" size="0.03 0.06 0.035" rgba="0.25 0.25 0.28 1"/>
                      <!-- wrist RGB-D camera (D435-like), looking along the tool axis -->
                      <geom class="visual" type="box" pos="0.065 0 -0.02" size="0.013 0.045 0.013" rgba="0.1 0.1 0.1 1"/>
                      <!-- image up = tool +x, so with the tool rolled "x up" the picture is upright -->
                      <camera name="wrist" pos="0.065 0 -0.035" xyaxes="0 -1 0 1 0 0" fovy="58"/>
                      <body name="finger_l" gravcomp="1" pos="0 0.0425 -0.075">
                        <joint name="finger_l" class="finger" axis="0 -1 0" range="0 0.0425"/>
                        <geom name="pad_l" class="finger" pos="0 0.006 -0.045" size="0.012 0.006 0.05"/>
                      </body>
                      <body name="finger_r" gravcomp="1" pos="0 -0.0425 -0.075">
                        <joint name="finger_r" class="finger" axis="0 1 0" range="0 0.0425"/>
                        <geom name="pad_r" class="finger" pos="0 -0.006 -0.045" size="0.012 0.006 0.05"/>
                      </body>
                      <!-- TCP at the fingertips (a closed gripper presses buttons with it); +z out of the gripper -->
                      <site name="tcp" pos="0 0 -0.17" quat="0 1 0 0" size="0.006" rgba="0 1 0 1" group="4"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    
  </worldbody>

  <contact>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link5" body2="gripper"/>
    <exclude body1="link6" body2="gripper"/>
    <exclude body1="gripper" body2="finger_l"/>
    <exclude body1="gripper" body2="finger_r"/>
  </contact>

  <equality>
    <joint joint1="finger_l" joint2="finger_r" polycoef="0 1 0 0 0" solref="0.005 1"/>
  </equality>

  <actuator>
    <position name="joint1" class="arm" joint="joint1"/>
    <position name="joint2" class="arm" joint="joint2"/>
    <position name="joint3" class="arm" joint="joint3"/>
    <position name="joint4" class="arm" joint="joint4" kp="600" forcerange="-30 30"/>
    <position name="joint5" class="arm" joint="joint5" kp="600" forcerange="-30 30"/>
    <position name="joint6" class="arm" joint="joint6" kp="300" forcerange="-20 20"/>
    <position name="gripper" class="finger" joint="finger_l" ctrlrange="0 0.0425"/>
  </actuator>

  <sensor>
    <force name="ft_force" site="ft_site"/>
    <torque name="ft_torque" site="ft_site"/>
  </sensor>
</mujoco>
