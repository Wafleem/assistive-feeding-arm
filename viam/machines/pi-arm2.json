     "frame": {"parent": "world", "translation": {"x": 0, "y": -600, "z": 0}, "orientation": {"type": "ov_degrees", "value": {"x": 0, "y": 0, "z": 1, "th": 0}}}},
    {"name": "follower-calibration", "api": "rdk:component:sensor", "model": "devrel:so101:calibration", "ui_folder": {"name": "calibration"},
