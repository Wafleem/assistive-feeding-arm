     "frame": {"parent": "world", "translation": {"x": 0, "y": 0, "z": -15}, "orientation": {"type": "ov_degrees", "value": {"x": 0, "y": 0, "z": 1, "th": 0}}}},
    {"name": "arm-camera", "api": "rdk:component:camera", "model": "rdk:builtin:webcam",
